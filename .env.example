# Host port used to access the backend container.
BACKEND_PORT=8000

# local, test, production
APP_ENV=local

# HTTPS 연결 여부 (HTTP 배포 또는 로컬에서는 false, HTTPS 도메인 적용 시 true)
HTTPS_ENABLED=false

# Required to sign JWT access tokens. Use a distinct long random value locally.
JWT_SECRET_KEY=replace-with-a-long-local-development-secret
JWT_ALGORITHM=HS256

# Access-token lifetime in days. Defaults to 7 when omitted.
JWT_ACCESS_TOKEN_EXPIRE_DAYS=7

# Refresh-token lifetime in days. Defaults to 14 when omitted.
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

# MariaDB connection settings.
DB_HOST=localhost

# Hostname used by the backend container on the Compose network.
DB_HOST_DOCKER=mariadb
DB_USER=philo
DB_PASSWORD=change-me
DB_NAME=philo

# Required only by the MariaDB container defined in docker-compose.yml.
MARIADB_ROOT_PASSWORD=change-root-password

# Email verification
FRONTEND_URL=http://localhost:3000
EMAIL_VERIFICATION_EXPIRE_HOURS=24

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=user@gmail.com
SMTP_PASSWORD=password
SMTP_FROM_EMAIL=Philo <user@gmail.com>
SMTP_USE_TLS=true
# LLM (OpenAI 호환 Chat Completions API) 설정
# 기본 설정 (사내/호환 게이트웨이 또는 OpenAI 직접 연동)
LLM_API_KEY=
LLM_BASE_URL=https://copa.codyssey.kr/v1
LLM_MODEL=gpt-5-mini

# [예시 1] 구글 제미나이 (Google Gemini - Google AI Studio 공식 OpenAI 호환 엔드포인트)
# LLM_API_KEY=AIzaSy... 또는 AQ...
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-1.5-flash

# [예시 2] 앤스로픽 클로드 (Anthropic Claude - OpenRouter / LiteLLM 프록시 경유)
# LLM_API_KEY=sk-or-v1-...
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=anthropic/claude-3.5-sonnet

# [예시 3] 로컬 오픈소스 모델 (Ollama)
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3:8b
