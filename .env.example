# Host port used to access the backend container.
BACKEND_PORT=8000

# local, test, production
APP_ENV=local

# Required to sign JWT access tokens. Use a distinct long random value locally.
JWT_SECRET_KEY=replace-with-a-long-local-development-secret
JWT_ALGORITHM=HS256

# Access-token lifetime in days. Defaults to 7 when omitted.
JWT_ACCESS_TOKEN_EXPIRE_DAYS=7

# MariaDB connection settings.
DB_HOST=localhost

# Hostname used by the backend container on the Compose network.
DB_HOST_DOCKER=mariadb
DB_PORT=3306
DB_USER=philo
DB_PASSWORD=change-me
DB_NAME=philo

# Required only by the MariaDB container defined in docker-compose.yml.
MARIADB_ROOT_PASSWORD=change-root-password
